generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum ScheduleStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  AWAITING_COMPLETION
}

enum UserRole {
  ADMIN
  CLIENT
}

enum BriefingStatus {
  DRAFT
  FINALIZED
}

enum ProjectReportStatus {
  PREPARING
  INTERNAL
  RELEASED
  ARCHIVED
}

enum DocumentVisibility {
  INTERNAL
  CLIENT
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

// Tópico 39: origem do documento no sistema comercial. Permite localizar a
// proposta/contrato que originou o arquivo sem duplicar o armazenamento.
enum DocumentSource {
  UPLOAD
  PROPOSAL
  CONTRACT
  CONTRACT_SIGNED
  PAYMENT_RECEIPT
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  // Prompt 4C, item 49 — negociação: o cliente pediu alteração sobre uma versão já
  // enviada. O ciclo continua ABERTO (o que o diferencia de APPROVED/REJECTED) e
  // a resposta é sempre uma NOVA versão, nunca a edição da que foi enviada.
  NEGOTIATING
  READY
  GENERATED
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(CLIENT)
  clientId     String?   @db.Uuid
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions     Session[]
  auditLogs    AuditLog[]
  proposalVersions ProposalVersion[]
  projectAccess ProjectAccess[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

/**
 * Recuperação de senha: link de uso único, com expiração.
 *
 * Guarda-se apenas o SHA-256 do token — o valor em claro só existe no e-mail.
 * `usedAt` permite invalidar o token depois de consumir e cortar sessões
 * antigas quando a senha muda.
 */
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * Tópico 36 — trilha de auditoria das ações críticas.
 *
 * `metadata` sozinho obrigava a abrir um blob para responder "quem/quando/qual
 * versão". Estas colunas tornaram a consulta direta e indexada:
 *   actorId + action + occurredAt  → quem fez, o quê e quando
 *   entityVersion                  → qual versão foi afetada
 *   fromStatus / toStatus          → estado anterior e posterior
 */
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  action        String
  entity        String
  entityId      String?
  metadata      Json?
  // Quem fez. NULL significa ação de sistema (ex.: automação de conversão),
  // e não "usuário desconhecido": são coisas diferentes.
  actorId       String?  @db.Uuid
  actorRole     String?
  actorLabel    String?
  // Versão da entidade afetada (ex.: versão 3 da proposta).
  entityVersion Int?
  // Transição de estado observada na ação.
  fromStatus    String?
  toStatus      String?
  // Contexto técnico para investigação de incidentes.
  ipAddress     String?
  requestId     String?
  outcome       String   @default("SUCCESS")
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([entityVersion])
}


model Client {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  fullName    String?
  email       String?
  phone       String?
  document    String?
  cpf         String?
  rg          String?
  address     Json?
  city        String?
  state       String?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  projects    Project[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([email])
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  clientId       String          @db.Uuid
  name           String
  type           String?
  description    String?
  scope          String?
  budget         Decimal?        @db.Decimal(12, 2)
  startDate      DateTime?
  expectedEndDate DateTime?
  status         ProjectStatus   @default(PLANNING)
  address        Json?
  notes          String?
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stages         ScheduleStage[]
  payments       Payment[]
  briefing       Briefing?
  reports        ProjectReport[]
  access         ProjectAccess[]
  documents      ProjectDocument[]
  proposals      Proposal[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
}

model ProjectAccess {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model ProjectDocument {
  id           String            @id @default(uuid()) @db.Uuid
  projectId    String            @db.Uuid
  name         String
  storageUrl   String
  mimeType     String?
  sizeBytes    BigInt?
  visibility   DocumentVisibility @default(INTERNAL)
  status       DocumentStatus    @default(ACTIVE)
  releasedAt   DateTime?
  archivedAt   DateTime?
  // Tópico 39: liga o arquivo à entidade comercial que o originou.
  source       DocumentSource    @default(UPLOAD)
  proposalId   String?           @db.Uuid
  contractId   String?           @db.Uuid
  // Tópico 4A: quando o ficheiro é uma referência do briefing, liga-se a ela.
  briefingReferences BriefingReference[]
  // Tópico 39: impede reenvio do mesmo artefato comercial. A chave é estável
  // por construção (ex.: "proposta:v3", "contrato:assinatura"), então
  // reexecutar a automação não duplica o documento.
  sourceKey    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proposal     Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contract     Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, visibility, status])
  @@unique([sourceKey])
  @@index([source])
}


model ProjectReport {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  title       String
  version     Int                @default(1)
  contentUrl  String?
  status      ProjectReportStatus @default(PREPARING)
  releasedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId, status])
}

model ScheduleStage {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  name           String
  discipline     String?
  designer       String?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  dueDate        DateTime?
  durationDays   Int?
  status         ScheduleStageStatus @default(NOT_STARTED)
  order          Int
  completion     Int                 @default(0)
  completedAt    DateTime?
  notes          String?
  dependencyId   String?             @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dependency     ScheduleStage?      @relation("StageDependency", fields: [dependencyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  dependents     ScheduleStage[]     @relation("StageDependency")
  payments       Payment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([projectId, order])
  @@index([projectId, status])
  @@index([dependencyId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  name             String
  amount           Decimal       @db.Decimal(12, 2)
  dueDate          DateTime?
  status           PaymentStatus @default(PENDING)
  note             String?
  order            Int
  percentage       Int?
  paidAt           DateTime?
  archivedAt       DateTime?
  scheduleStageId  String?       @db.Uuid
  // Tópico 38: liga a parcela à proposta que a originou, permitindo detectar
  // e não recriar parcelas já geradas.
  sourceProposalId String?       @db.Uuid
  sourceKey        String?
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleStage    ScheduleStage? @relation(fields: [scheduleStageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceProposal   Proposal?     @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([projectId, order])
  @@unique([sourceKey])
  @@index([projectId, status])
  @@index([scheduleStageId])
  @@index([sourceProposalId])
}

model Briefing {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @unique @db.Uuid
  responses   Json
  status      BriefingStatus @default(DRAFT)
  version     Int      @default(1)
  submittedAt DateTime?
  finalizedAt DateTime?
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  revisions   BriefingRevision[]
  accessLinks BriefingAccessLink[]
  // Tópico 4A: o que o cliente respondeu para além do texto.
  references  BriefingReference[]
  audioNotes  BriefingAudioNote[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model BriefingAccessLink {
  id          String   @id @default(uuid()) @db.Uuid
  briefingId  String   @db.Uuid
  tokenHash   String   @unique
  revokedAt   DateTime?
  expiresAt   DateTime?
  firstAccessAt DateTime?
  lastAccessAt DateTime?
  createdAt   DateTime @default(now())
  briefing    Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([briefingId, revokedAt])
}

model BriefingRevision {
  id          String   @id @default(uuid()) @db.Uuid
  briefingId  String   @db.Uuid
  version     Int
  responses   Json
  createdAt   DateTime @default(now())
  briefing    Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([briefingId, version])
  @@index([briefingId, createdAt])
}

model BriefingVisualOption {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String
  value       String
  title       String
  description String?
  imageUrl    String?
  altText     String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId, sortOrder])
  @@unique([questionId, value])
}

// Tópico 4A — o que o cliente sobre as referências visuais.
//
// `BriefingVisualOption` guarda as imagens que o ADMIN publica nas perguntas.
// Este guarda o que o CLIENTE respondeu: a referência que enviou, o que gosta e
// o que não gosta nela, e se continua de pé. Sem esta distinção, uma imagem
// aprovada é lida inteira como um "sim" — e o cliente pode gostar da luz e
// detestar o mobiliário.
//
// A resposta do cliente é `likes`/`dislikes`. A opinião do profissional entra em
// `professionalNote` e não reescreve nada do que o cliente disse.
model BriefingReference {
  id               String   @id @default(uuid()) @db.Uuid
  briefingId       String   @db.Uuid
  questionId       String
  // Chave no storage quando é um ficheiro; null quando é uma opção do catálogo.
  storageKey       String?
  documentId       String?  @db.Uuid
  visualOptionId   String?  @db.Uuid
  fileName         String?
  mimeType         String?
  sizeBytes        BigInt?
  // REFERENCIA, FOTO_IMOVEL, DOCUMENTO — ou outra categoria declarada pela
  // pergunta. Texto livre de propósito: o briefing cresce sem migration.
  category         String   @default("REFERENCIA")
  // O que o cliente diz que gosta e o que diz que não gosta, desta referência.
  likes            String?  @db.Text
  dislikes         String?  @db.Text
  // Ambiente do programa a que a referência se refere, quando se aplica.
  environmentId    String?
  selected         Boolean  @default(true)
  discarded        Boolean  @default(false)
  professionalNote String?  @db.Text
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  briefing         Briefing             @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  document         ProjectDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([briefingId, category])
  @@index([briefingId, createdAt])
}

// Tópico 4A — resposta por áudio.
//
// O áudio original NUNCA é apagado: a transcrição automática e a corrigida pelo
// cliente são colunas separadas do mesmo registo. Se a transcrição automática
// falhar, o cliente ainda pode ouvir e escrever — e o áudio continua lá para
// o profissional.
enum BriefingAudioStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

model BriefingAudioNote {
  id           String              @id @default(uuid()) @db.Uuid
  briefingId   String              @db.Uuid
  questionId   String
  storageKey   String
  mimeType     String
  sizeBytes    BigInt?
  status       BriefingAudioStatus @default(UPLOADED)
  // Identificador do serviço que transcreveu, quando existe. Null significa
  // "sem provider configurado" — nunca "transcrito".
  provider     String?
  // Texto exacto como saiu do provider. Não é a resposta final.
  transcript   String?             @db.Text
  // Texto que o cliente corrigiu ou confirmou.
  reviewedText String?             @db.Text
  errorMessage String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  briefing     Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([briefingId, questionId])
  @@index([status])
}

model Proposal {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  status         ProposalStatus  @default(DRAFT)
  currentVersion Int             @default(1)
  expiresAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvalIp     String?
  approvalMeta   Json?
  approvedVersion Int?
  // Prompt 4C, item 3 — identificação comercial legível (ex.: "PROP-2026-0007").
  //
  // Gerado pelo servidor na criação. É estável e sequencial-por-ano apenas para o
  // ADMIN: o link público NUNCA o expõe, porque o identificador não é autorização.
  code           String?         @unique
  // Prompt 4C, item 45 — versão que o link público exibe.
  //
  // Sem esta coluna, o carregador público lia sempre a versão MAIS RECENTE. Isso
  // quebrava a garantia central da fase: o cliente aprovava o V1 e, se o ADMIN
  // editasse depois, o mesmo link passava a mostrar o V2 — o cliente aprovava
  // outra coisa sem ter lido. Fixar a versão no link torna o link uma FOTOGRAFIA
  // do que foi enviado.
  publishedVersion Int?
  publishedAt      DateTime?
  // Prompt 4C, item 24 — snapshot do preço efectivamente usado por esta versão.
  //
  // Congelado na gravação da versão. Sem ele, alterar o catálogo mudaria o número
  // de uma proposta já enviada, e o contrato bornaria de um valor que o cliente
  // nunca viu.
  pricingSnapshot  Json?
  // Tópico 37: marca de conversão. Numa única conversão por proposta, estes
  // campos são gravados na mesma transação das parcelas, do serviço e dos
  // documentos. Se a transação falhar, nada fica gravado e a próxima execução
  // parte do zero — em vez de converter metade do negócio.
  convertedAt    DateTime?
  conversionKey  String?
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions       ProposalVersion[]
  accessLinks    ProposalAccessLink[]
  contract       Contract?
  documents      ProjectDocument[]
  payments       Payment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId, status])
  @@index([status, updatedAt])
  @@unique([conversionKey])
}


model ProposalVersion {
  id             String    @id @default(uuid()) @db.Uuid
  proposalId     String    @db.Uuid
  version        Int
  title          String
  presentation   Json
  formalText     Json
  services       Json
  subtotal       Decimal   @db.Decimal(12, 2)
  adjustment     Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  authorId       String?   @db.Uuid
  frozenAt       DateTime?
  pricing        Json?
  // Prompt 18, itens 2 e 5 — plano de pagamento CONGELADO por versão.
  //
  // Antes desta coluna o plano não era persistido: era re-interpretado do texto
  // livre `formalText.formaPagamento` a cada leitura. Isso tornava uma proposta
  // já publicada mutável (basta editar o texto) e permitia que ADMIN e cliente
  // vissem planos diferentes. Congelando aqui, a versão publicada é
  // historicamente reproduzível e ambos leem a mesma fonte.
  //
  // NULL significa apenas "versão criada antes desta migração"; o leitor trata
  // esse caso à parte, com aviso explícito.
  paymentPlan    Json?
  createdAt      DateTime  @default(now())
  proposal       Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([proposalId, version])
  @@index([proposalId, createdAt])
}

model ProposalAccessLink {
  id          String    @id @default(uuid()) @db.Uuid
  proposalId  String    @db.Uuid
  tokenHash   String    @unique
  revokedAt   DateTime?
  expiresAt   DateTime?
  firstAccessAt DateTime?
  lastAccessAt DateTime?
  // Prompt 4C, item 42 — o link aponta para UMA versão específica.
  //
  // NULL significa "proposta ainda não publicada" (legado/rascunho). O leitor
  // público recusa nesse caso em vez de escolher a versão mais recente por conta
  // própria: escolher seria publicar algo que ninguém revisou.
  versionNumber Int?
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime  @default(now())

  @@index([proposalId, revokedAt])
  @@index([versionNumber])
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  READY
  SENT
  VIEWED
  SIGNED
  CANCELLED
}

enum SignatureStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  COMPLETED
  CANCELLED
  FAILED
}

// Tópico 3: unidade de cobrança configurável. O banco nunca é fixo em m².
enum ServiceUnit {
  M2
  AMBIENTE
  UNIDADE
  IMAGEM
  PACOTE
  FIXO
  HORA
  PERCENTUAL
}

// Tópico 5: faixas comerciais definidas pelo ADMIN (não são níveis de qualidade).
enum PricingLevel {
  BAIXO
  MEDIO
  ALTO
}

// Tópico 4: cadastro administrativo de serviços e precificação.
model ServiceItem {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  discipline           String
  category             String?
  descriptionCommercial String?
  descriptionTechnical String?
  unit                 ServiceUnit
  baseLow              Decimal  @default(0) @db.Decimal(12, 2)
  baseMedium           Decimal  @default(0) @db.Decimal(12, 2)
  baseHigh             Decimal  @default(0) @db.Decimal(12, 2)
  minPrice             Decimal? @db.Decimal(12, 2)
  minQuantity          Decimal? @db.Decimal(12, 2)
  maxQuantity          Decimal? @db.Decimal(12, 2)
  increment            Decimal? @db.Decimal(12, 2)
  estimatedDays        Int?
  displayOrder         Int      @default(0)
  active               Boolean  @default(true)
  scope                String?
  exclusions           String?
  notes                String?
  dependencies         Json?
  calculationRules     Json?
  presentationImages   Json?
  icon                 String?
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  priceHistory         ServicePriceHistory[]
  packageItems         PackageItem[]

  @@unique([discipline, name])
  @@index([discipline, active, displayOrder])
}

// Tópico 4: histórico obrigatório de alteração de preços.
model ServicePriceHistory {
  id            String       @id @default(uuid()) @db.Uuid
  serviceId     String       @db.Uuid
  level         PricingLevel
  previousValue Decimal?     @db.Decimal(12, 2)
  newValue      Decimal      @db.Decimal(12, 2)
  reason        String?
  changedById   String?      @db.Uuid
  service       ServiceItem  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime     @default(now())

  @@index([serviceId, createdAt])
}

// Tópico 11: pacotes configuráveis; os nomes ficam no banco.
model CommercialPackage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  items       PackageItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PackageItem {
  id            String            @id @default(uuid()) @db.Uuid
  packageId     String            @db.Uuid
  serviceId     String            @db.Uuid
  displayOrder  Int               @default(0)
  optional      Boolean           @default(false)
  overrideUnit  ServiceUnit?
  overridePrice Decimal?          @db.Decimal(12, 2)
  package       CommercialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service       ServiceItem       @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([packageId, serviceId])
}

model ContractSignature {
  id             String          @id @default(uuid()) @db.Uuid
  contractId     String          @unique @db.Uuid
  provider       String
  externalId     String?
  signatoryName  String
  signatoryEmail String?
  signatoryPhone String?
  status         SignatureStatus @default(PENDING)
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  completedAt    DateTime?
  evidence       Json?
  lastError      String?         @db.Text
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, updatedAt])
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  channel   String
  name      String
  body      String   @db.Text
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel, active])
}

model NotificationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  channel     String
  templateKey String?
  recipient   String?
  subject     String?
  body        String   @db.Text
  status      String
  error       String?  @db.Text
  payload     Json?
  entityType  String?
  entityId    String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([type, occurredAt])
  @@index([entityType, entityId])
  @@index([status, occurredAt])
}

model ContractTemplate {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  version   Int       @default(1)
  active    Boolean   @default(true)
  isDefault Boolean   @default(false)
  body      String    @db.Text
  clauses   Json
  scopeKey   String?
  disciplines String[] @default([])
  contracts  Contract[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, isDefault])
}

model Contract {
  id              String          @id @default(uuid()) @db.Uuid
  proposalId      String          @unique @db.Uuid
  version         Int
  title           String
  content         Json
  status          ContractStatus  @default(DRAFT)
  templateId      String?         @db.Uuid
  templateVersion Int?
  signature       ContractSignature?
  generatedAt     DateTime        @default(now())
  sentAt          DateTime?
  viewedAt        DateTime?
  signedAt        DateTime?
  signatureMeta   Json?
  proposal        Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  template        ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Tópico 39: o contrato e a via assinada vivem no mesmo módulo de documentos.
  documents       ProjectDocument[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, updatedAt])
}

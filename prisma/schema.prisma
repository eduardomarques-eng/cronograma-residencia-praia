generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum ScheduleStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  AWAITING_COMPLETION
}

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(CLIENT)
  clientId     String?   @db.Uuid
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  fullName    String?
  email       String?
  phone       String?
  document    String?
  address     Json?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  projects    Project[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([email])
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  clientId       String          @db.Uuid
  name           String
  type           String?
  description    String?
  scope          String?
  budget         Decimal?        @db.Decimal(12, 2)
  startDate      DateTime?
  expectedEndDate DateTime?
  status         ProjectStatus   @default(PLANNING)
  address        Json?
  notes          String?
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stages         ScheduleStage[]
  payments       Payment[]
  briefing       Briefing?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
}

model ScheduleStage {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  name           String
  discipline     String?
  designer       String?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  dueDate        DateTime?
  durationDays   Int?
  status         ScheduleStageStatus @default(NOT_STARTED)
  order          Int
  completion     Int                 @default(0)
  completedAt    DateTime?
  notes          String?
  dependencyId   String?             @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dependency     ScheduleStage?      @relation("StageDependency", fields: [dependencyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  dependents     ScheduleStage[]     @relation("StageDependency")
  payments       Payment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([projectId, order])
  @@index([projectId, status])
  @@index([dependencyId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  name             String
  amount           Decimal       @db.Decimal(12, 2)
  dueDate          DateTime?
  status           PaymentStatus @default(PENDING)
  note             String?
  order            Int
  percentage       Int?
  paidAt           DateTime?
  archivedAt       DateTime?
  scheduleStageId  String?       @db.Uuid
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleStage    ScheduleStage? @relation(fields: [scheduleStageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([projectId, order])
  @@index([projectId, status])
  @@index([scheduleStageId])
}

model Briefing {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @unique @db.Uuid
  responses   Json
  submittedAt DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

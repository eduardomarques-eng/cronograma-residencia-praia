generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum ScheduleStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PAID
  PENDING
  AWAITING_COMPLETION
}

enum UserRole {
  ADMIN
  CLIENT
}

enum BriefingStatus {
  DRAFT
  FINALIZED
}

enum ProjectReportStatus {
  PREPARING
  INTERNAL
  RELEASED
  ARCHIVED
}

enum DocumentVisibility {
  INTERNAL
  CLIENT
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(CLIENT)
  clientId     String?   @db.Uuid
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions     Session[]
  auditLogs    AuditLog[]
  projectAccess ProjectAccess[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  fullName    String?
  email       String?
  phone       String?
  document    String?
  address     Json?
  notes       String?
  status      ClientStatus @default(ACTIVE)
  projects    Project[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([email])
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  clientId       String          @db.Uuid
  name           String
  type           String?
  description    String?
  scope          String?
  budget         Decimal?        @db.Decimal(12, 2)
  startDate      DateTime?
  expectedEndDate DateTime?
  status         ProjectStatus   @default(PLANNING)
  address        Json?
  notes          String?
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stages         ScheduleStage[]
  payments       Payment[]
  briefing       Briefing?
  reports        ProjectReport[]
  access         ProjectAccess[]
  documents      ProjectDocument[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
}

model ProjectAccess {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model ProjectDocument {
  id           String            @id @default(uuid()) @db.Uuid
  projectId    String            @db.Uuid
  name         String
  storageUrl   String
  mimeType     String?
  sizeBytes    BigInt?
  visibility   DocumentVisibility @default(INTERNAL)
  status       DocumentStatus    @default(ACTIVE)
  releasedAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId, visibility, status])
}

model ProjectReport {
  id          String             @id @default(uuid()) @db.Uuid
  projectId   String             @db.Uuid
  title       String
  version     Int                @default(1)
  contentUrl  String?
  status      ProjectReportStatus @default(PREPARING)
  releasedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId, status])
}

model ScheduleStage {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  name           String
  discipline     String?
  designer       String?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  dueDate        DateTime?
  durationDays   Int?
  status         ScheduleStageStatus @default(NOT_STARTED)
  order          Int
  completion     Int                 @default(0)
  completedAt    DateTime?
  notes          String?
  dependencyId   String?             @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dependency     ScheduleStage?      @relation("StageDependency", fields: [dependencyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  dependents     ScheduleStage[]     @relation("StageDependency")
  payments       Payment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([projectId, order])
  @@index([projectId, status])
  @@index([dependencyId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  projectId        String        @db.Uuid
  name             String
  amount           Decimal       @db.Decimal(12, 2)
  dueDate          DateTime?
  status           PaymentStatus @default(PENDING)
  note             String?
  order            Int
  percentage       Int?
  paidAt           DateTime?
  archivedAt       DateTime?
  scheduleStageId  String?       @db.Uuid
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleStage    ScheduleStage? @relation(fields: [scheduleStageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([projectId, order])
  @@index([projectId, status])
  @@index([scheduleStageId])
}

model Briefing {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @unique @db.Uuid
  responses   Json
  status      BriefingStatus @default(DRAFT)
  version     Int      @default(1)
  submittedAt DateTime?
  finalizedAt DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  revisions   BriefingRevision[]
  accessLinks BriefingAccessLink[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BriefingAccessLink {
  id          String   @id @default(uuid()) @db.Uuid
  briefingId  String   @db.Uuid
  tokenHash   String   @unique
  revokedAt   DateTime?
  expiresAt   DateTime?
  firstAccessAt DateTime?
  lastAccessAt DateTime?
  createdAt   DateTime @default(now())
  briefing    Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([briefingId, revokedAt])
}

model BriefingRevision {
  id          String   @id @default(uuid()) @db.Uuid
  briefingId  String   @db.Uuid
  version     Int
  responses   Json
  createdAt   DateTime @default(now())
  briefing    Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([briefingId, version])
  @@index([briefingId, createdAt])
}

model BriefingVisualOption {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String
  value       String
  title       String
  description String?
  imageUrl    String?
  altText     String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId, sortOrder])
  @@unique([questionId, value])
}

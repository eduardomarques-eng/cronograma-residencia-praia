{
  "name": "cronograma-arqvertice",
  "version": "2.1.0",
  "private": true,
  "description": "ArqVértice Flow — fundação moderna em migração incremental do painel legado.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",

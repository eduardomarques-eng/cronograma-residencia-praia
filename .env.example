# Server-only PostgreSQL connection.
DATABASE_URL="postgresql://user:password@localhost:5432/arqvertice_flow"

# Optional CA certificate for a managed PostgreSQL provider using a private CA.
DATABASE_SSL_CA=""

# Public URL used for canonical metadata and callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional release identifier shown by the health endpoint.
APP_VERSION="local"

# WhatsApp (Tópico 21). As credenciais ficam somente no servidor.
# "wa.me" prepara o link para envio manual pelo ADMIN; "api" usa o provedor oficial.
WHATSAPP_PROVIDER="wa.me"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Identificação da empresa usada nos contratos.
COMPANY_LEGAL_NAME="ARQVERTICE"
COMPANY_LEGAL_DOCUMENT=""

# Assinatura digital (Tópico 27). "manual" NÃO é assinatura jurídica digital:
# apenas registra a entrega do documento para assinatura fora da plataforma.
# "http" usa o provedor externo oficial.
SIGNATURE_PROVIDER="manual"
SIGNATURE_API_URL=""
SIGNATURE_API_TOKEN=""

# At least 32 random characters in development and production.
AUTH_SECRET="replace-with-a-long-random-value-at-least-32-characters"

# Recuperação de senha ("Esqueci a senha") — envio por e-mail via Resend.
# Sem RESEND_API_KEY o fluxo continua a funcionar: o link é gerado e registado,
# mas o e-mail não sai (e o pedido continua a devolver a mesma resposta).
RESEND_API_KEY=""
# Remetente validado no Resend. Sem isto, o Resend usa o endereço de teste.
EMAIL_FROM="ARQVERTICE <nao-responda@seudominio.com>"

# Chave de escrita das serverless legadas em /api (Tópico 17 — auditoria de
# produção). `api/_db.js` exige o cabeçalho `x-chave-admin` igual a este valor
# em qualquer escrita. SEM esta variável as funções de escrita ficam
# inacessíveis — por isso não é opcional.
ADMIN_KEY="replace-with-a-long-random-admin-key"

# Credenciais do seed — NUNCA commitar valores reais.
# Defina estas variáveis no ambiente (Vercel → Settings → Environment Variables)
# e execute `npm run db:seed`. A password é guardada com hash; o valor em claro
# só existe no ambiente.
#
# A senha do CLIENT é OPCIONAL: sem ela, só é criada a conta de ADMIN.
SEED_ADMIN_NAME="Eduardo Marques"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_CLIENT_EMAIL="cliente@example.com"
SEED_CLIENT_PASSWORD=""

# Funcionário da equipa (OPERADOR) — acesso RESTRITO à operação do cronograma.
# OPCIONAL: sem SEED_OPERADOR_PASSWORD o seed não cria a conta. O operador não
# tem cliente associado; o ADMIN atribui-lhe projetos (ProjectAccess) e ele
# opera o cronograma só desses projetos. Senha com 12+ caracteres.
SEED_OPERADOR_NAME="Operador"
SEED_OPERADOR_EMAIL="operador@example.com"
SEED_OPERADOR_PASSWORD=""

# FASE 4C — Proposal Studio: modelo de linguagem (Opcional).
# O Studio funciona NA TOTALIDADE sem estas variáveis: resumir, em lista, em
# cards, melhorar layout, reordenar e trocar layout são locais. Só a REESCRITA
# DE LINGUAGEM precisa de um serviço, e sem endpoint o editor explica isso em
# vez de fingir que reescreveu.
# O serviço é do estúdio (mesma convenção de TRANSCRIPTION_ENDPOINT/SIGNATURE_API_URL);
# o prompt e as regras comerciais são construídos em src/server/services/studio-ai-service.ts.
STUDIO_AI_ENDPOINT=""
STUDIO_AI_API_KEY=""

# Private S3-compatible document storage (required in production).
STORAGE_BUCKET="arqvertice-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# Server-only PostgreSQL connection.
DATABASE_URL="postgresql://user:password@localhost:5432/arqvertice_flow"

# Public URL used for canonical metadata and callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# At least 32 random characters in development and production.
AUTH_SECRET="replace-with-a-long-random-value-at-least-32-characters"

# Optional seed credentials; never commit real values.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-development-password"
SEED_CLIENT_EMAIL="cliente@example.com"
SEED_CLIENT_PASSWORD="replace-with-a-development-password"

# Private S3-compatible document storage (required in production).
STORAGE_BUCKET="arqvertice-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
